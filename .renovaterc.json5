{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#9.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#9.0.0",
    "github>home-operations/renovate-presets//apps/llamacpp.json5#9.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#9.0.0",
    "github>phycoforce/home-ops//.renovate/allowedVersions.json5",
    "github>phycoforce/home-ops//.renovate/autoMerge.json5",
    "github>phycoforce/home-ops//.renovate/groups.json5",
    "github>phycoforce/home-ops//.renovate/labels.json5",
    ":semanticCommits",
    ":timezone(Europe/London)",
  ],
  // No branch protection requires up-to-date branches, and `auto` would
  // still rebase every automerge PR each time main moves
  rebaseWhen: "conflicted",
  packageRules: [
    {
      description: "Claude Code ships near-daily: bump the CLI pinned in hermes weekly, and only to releases 3+ days old so a pulled one is never proposed",
      matchDatasources: ["npm"],
      matchPackageNames: ["@anthropic-ai/claude-code"],
      schedule: ["before 6am on Monday"],
      minimumReleaseAge: "3 days",
    },
  ],
}
